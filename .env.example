# Copy to `.env` for local development. honcho loads `.env` automatically.

# How long a login lasts, in days. The window slides forward on each visit, so
# you only re-enter the Up token after this long without opening the app.
# SESSION_TTL_DAYS=30

# How often the boot probe re-checks the Up token (in hours). Between checks the
# stored session is trusted, so page loads do not always cost an Up request.
# SESSION_VERIFY_HOURS=6

# Where the server-side session store lives. It holds live Up tokens, so keep it
# off shared disks. Defaults to `.sessions.sqlite3` next to main.py.
# SESSION_DB_PATH=.sessions.sqlite3

# Set to any non-empty value in production so the cookie gets the Secure flag.
# SESSION_HTTPS_ONLY=1

# Extra origins allowed to make unsafe (POST/PATCH/DELETE) requests. Same-origin
# requests are always allowed; use this only for a separate frontend origin.
# ALLOWED_ORIGINS=https://upbank.example.com

# Public HTTPS URL for Up webhook delivery, e.g. via ngrok:
# WEBHOOK_URL=https://your-tunnel.example.com/api/webhooks
