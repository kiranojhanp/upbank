{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "preview": "vite preview",
    "test:db": "node scripts/db-smoke.mjs",
    "test:csv": "vite build --ssr scripts/csv-check.ts --outDir .csv-check --emptyOutDir >/dev/null && node .csv-check/csv-check.js && rm -rf .csv-check",
    "test:budget": "vite build --ssr scripts/budget-check.ts --outDir .budget-check --emptyOutDir >/dev/null && node .budget-check/budget-check.js && rm -rf .budget-check",
    "test:week": "vite build --ssr scripts/week-check.ts --outDir .week-check --emptyOutDir >/dev/null && node .week-check/week-check.js && rm -rf .week-check",
    "test:backup": "vite build --ssr scripts/backup-check.ts --outDir .backup-check --emptyOutDir >/dev/null && node .backup-check/backup-check.js && rm -rf .backup-check",
    "test:security": "vite build --ssr scripts/security-check.ts --outDir .security-check --emptyOutDir >/dev/null && node .security-check/security-check.js && rm -rf .security-check",
    "test:pagination": "vite build --ssr scripts/pagination-check.ts --outDir .pagination-check --emptyOutDir >/dev/null && node .pagination-check/pagination-check.js && rm -rf .pagination-check",
    "test:persistence": "vite build --ssr scripts/persistence-smoke.ts --outDir .persistence-smoke --emptyOutDir >/dev/null && node .persistence-smoke/persistence-smoke.js && rm -rf .persistence-smoke",
    "test:render": "node scripts/render-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@journeyapps/wa-sqlite": "1.7.2",
    "@tanstack/browser-db-sqlite-persistence": "1.0.0-rc.1.3",
    "@tanstack/db": "1.0.0-rc.1.3",
    "@tanstack/query-core": "5.106.0",
    "@tanstack/query-db-collection": "1.5.1",
    "@tanstack/react-db": "1.0.0-rc.1.3",
    "@tanstack/react-query": "5.106.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.68.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
